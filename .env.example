# .env.example
# Скопируйте этот файл в .env и заполните своими значениями

# PostgreSQL
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_password
# Адрес базы для запуска Django без Docker (например, из PyCharm).
# В Docker compose сам подставит db:5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Django
# Сгенерируйте свой ключ командой:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# На сервере должно быть False
DEBUG=True
# Через запятую, без пробелов. На сервере допишите IP или домен
ALLOWED_HOSTS=127.0.0.1,localhost